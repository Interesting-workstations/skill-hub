# skill-hub 生产部署配置模板
# 复制为 .env 并按需修改（.env 不提交到 git）

# ---- MySQL ----
# root 密码（仅首次启动数据卷为空时生效；之后修改需清掉 mysql_data 卷）
MYSQL_ROOT_PASSWORD=root
# 数据库名
MYSQL_DATABASE=skillhub

# ---- GitHub ----
# GitHub Token（爬虫必需；https://github.com/settings/tokens 生成，repo 权限）
GITHUB_TOKEN=

# ---- admin Token 签名密钥（安全） ----
# 固定长字符串（>=32 字符），如 openssl rand -hex 32 生成；
# 不配置则每次重启随机生成，会导致已登录用户刷新后 Token 失效
ADMIN_TOKEN_SECRET=

# ---- 中英翻译（技能标题/描述） ----
# auto=按 腾讯云→百度→Google→DeepL 依次尝试，哪个能走通用哪个
# 也可指定：tencent / baidu / google / deepl（失败自动降级后续通道）
TRANSLATE_PROVIDER=auto
# 腾讯云机器翻译 TMT（每月免费额度；https://console.cloud.tencent.com/cam/capi）
# TX_SECRETID=
# TX_SECRETKEY=
# 百度通用翻译（有免费额度；https://fanyi-api.baidu.com）
# BAIDU_APPID=
# BAIDU_KEY=
# DeepL（需 Key）
# DEEPL_KEY=

# ---- 对外端口 ----
WEB_PORT=8080        # 官网（访问 http://服务器IP:8080）
ADMIN_PORT=8081      # 运营后台（访问 http://服务器IP:8081）

# ---- 后台访问隐藏（安全） ----
# admin 前端入口路径前缀（随机字符串，仅你自己知道）
# 访问地址：http://服务器IP:8081/<ADMIN_BASE>/；未知路径一律 404
ADMIN_BASE=
# admin API secret 前缀（Nginx 反代时剥离后转发后端，建议与 ADMIN_BASE 不同）
ADMIN_SECRET=
