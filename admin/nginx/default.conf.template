# skill-hub 运营后台 Nginx：隐藏入口 + API 反代（含 WebSocket）
# ${ADMIN_BASE} / ${ADMIN_SECRET} 由镜像模板机制（envsubst）注入：
#   - ADMIN_BASE  = 后台前端访问路径前缀（如 361d130e47 → http://IP:8081/361d130e47/）
#   - ADMIN_SECRET = 后台 API secret 前缀（/api/v1/<secret>/admin/*，反代时剥离）
# 未配置 secret 时，除 404 外不暴露任何后台入口，避免被扫描发现。
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    client_max_body_size 20m;

    # 隐藏路径下的静态资源长缓存
    location /${ADMIN_BASE}/assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 不带结尾斜杠的访问重定向到带斜杠路径（$http_host 保留 Host 头端口）
    location = /${ADMIN_BASE} {
        return 301 $scheme://$http_host/${ADMIN_BASE}/;
    }

    # 后台入口：仅 /<secret>/ 路径可访问（SPA 路由回退）
    location /${ADMIN_BASE}/ {
        try_files $uri $uri/ /${ADMIN_BASE}/index.html;
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }

    # API 反向代理：剥离 secret 前缀后转发后端（含 WebSocket 升级）
    location /api/v1/${ADMIN_SECRET}/ {
        rewrite ^/api/v1/${ADMIN_SECRET}/(.*)$ /api/v1/$1 break;
        proxy_pass http://server:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 公开图片代理：组织 logo 本地缓存 / 官网图片代理（无需 secret，官网同样使用）
    location ~ ^/api/v1/(org-logo|img-proxy) {
        proxy_pass http://server:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # 其余路径一律 404（隐藏后台入口，避免被扫描器发现）
    location / {
        return 404;
    }
}
