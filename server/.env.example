# Agent Skills API 环境配置
# 复制为 .env 并按需修改（.env 不提交到 git）

# GitHub Token（爬虫必需，用于提升 API 速率限制；在 https://github.com/settings/tokens 生成）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# MySQL 连接串
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/skillhub?charset=utf8mb4&parseTime=true

# HTTP 监听地址
SERVER_ADDR=:8080

# 种子数据路径
SEED_PATH=data/skills.json

# ---- 技能中英翻译（技能标题/描述的中文版，供官网语言切换） ----
# 翻译方式：默认 google（无需 Key，免费接口，中国大陆网络可能不可达）；
# 也可配置 baidu（BAIDU_APPID + BAIDU_KEY，有免费额度）或 deepl（DEEPL_KEY）。
TRANSLATE_PROVIDER=google
# BAIDU_APPID=
# BAIDU_KEY=
# DEEPL_KEY=

# 存量数据翻译（历史数据补齐 name_zh / description_zh）：
#   cd server && go run ./cmd/translate -concurrency 8
# 新爬取的数据入库时会自动翻译（无需额外操作）。
