# Agent Skills API 环境配置
# 复制为 .env 并按需修改（.env 不提交到 git）

# GitHub Token（爬虫必需，用于提升 API 速率限制；在 https://github.com/settings/tokens 生成）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# MySQL 连接串
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/skillhub?charset=utf8mb4&parseTime=true

# HTTP 监听地址
SERVER_ADDR=:8080

# 种子数据路径
SEED_PATH=data/skills.json
